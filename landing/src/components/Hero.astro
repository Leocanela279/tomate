---
import Icon from './Icon.astro';
import AppShowcase from './AppShowcase.astro';
import { DMG_URL } from '../lib/site';
---

<section id="inicio" class="relative px-4 pt-28 sm:px-6 sm:pt-36">
  <div class="mx-auto max-w-6xl text-center">
    <p class="glass mx-auto inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-[13px] font-semibold text-ink-2">
      <span class="size-2 rounded-full bg-leaf shadow-[0_0_10px_var(--leaf)]"></span>
      Gratis para macOS · Sin cuentas
    </p>

    <h1 class="mx-auto mt-6 max-w-4xl text-[clamp(2.5rem,7.4vw,5.4rem)] leading-[1.02] font-bold tracking-[-0.035em] text-balance">
      Estudia en pomodoros de <span class="accent-word">hasta 90&nbsp;minutos</span>
    </h1>

    <p class="mx-auto mt-6 max-w-2xl text-[clamp(1.05rem,2.2vw,1.25rem)] leading-relaxed text-ink-2 text-pretty">
      Tomate es un temporizador para Mac pensado para sesiones largas. Divide las de 60 y 90&nbsp;minutos con un
      descanso a mitad, programa las siguientes y mira el tiempo desde la barra de menú.
    </p>

    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <a href={DMG_URL} class="btn-primary !min-h-12 !px-7 !text-base">
        <Icon name="apple" size={18} />
        Descargar para Mac
      </a>
      <a href="#instalar" class="btn-glass glass !min-h-12 !px-6">Cómo instalarlo</a>
    </div>
    <p class="mt-4 text-[13px] text-ink-3">macOS 14 Sonoma o posterior · Apple Silicon e Intel</p>
  </div>

  <!-- The app itself, playing on its own. -->
  <!-- 880 px: the real window size, so the 2x captures stay pixel-sharp on Retina screens. -->
  <div class="reveal-up mx-auto mt-14 max-w-[880px] sm:mt-20">
    <AppShowcase />
  </div>
</section>

<style>
  .accent-word {
    background: linear-gradient(100deg, var(--text) 10%, color-mix(in srgb, var(--accent) 55%, #ffb199) 55%, var(--text) 95%);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 6s ease-in-out infinite;
  }

  @keyframes shine {
    0%, 100% { background-position: 0% 0; }
    50% { background-position: 100% 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .accent-word { animation: none; }
  }
</style>
