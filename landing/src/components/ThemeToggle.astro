---
/** Round glass button: moon in tomato mode, sun in dark mode. The new look grows out of it. */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<button
  type="button"
  class:list={['theme-toggle btn-icon glass', className]}
  data-theme-toggle
  aria-label="Cambiar a modo oscuro"
  title="Cambiar a modo oscuro"
>
  <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
    <path fill="currentColor" d="M20.2 14.6A8.6 8.6 0 0 1 9.4 3.8a.8.8 0 0 0-1-1A9.9 9.9 0 1 0 21.2 15.6a.8.8 0 0 0-1-1Z" />
  </svg>
  <svg class="icon-sun" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
    <circle cx="12" cy="12" r="4.6" fill="currentColor" />
    <g stroke="currentColor" stroke-width="2.1" stroke-linecap="round">
      <path d="M12 1.8v2.4M12 19.8v2.4M1.8 12h2.4M19.8 12h2.4M4.8 4.8l1.7 1.7M17.5 17.5l1.7 1.7M4.8 19.2l1.7-1.7M17.5 6.5l1.7-1.7" />
    </g>
  </svg>
</button>

<style>
  .theme-toggle {
    position: relative;
    overflow: hidden;
  }

  /* Like SF Symbols' replace.downUp: the old symbol leaves upwards, the new one rises in. */
  .theme-toggle svg {
    position: absolute;
    inset: 0;
    margin: auto;
    transition:
      transform 0.45s var(--spring),
      opacity 0.25s ease-out,
      filter 0.25s ease-out;
  }

  .icon-sun {
    opacity: 0;
    transform: translateY(14px) scale(0.6);
    filter: blur(2px);
  }

  :global([data-theme="dark"]) .icon-moon {
    opacity: 0;
    transform: translateY(-14px) scale(0.6);
    filter: blur(2px);
  }

  :global([data-theme="dark"]) .icon-sun {
    opacity: 1;
    transform: none;
    filter: none;
  }

  /* A small bounce on the button itself, like .symbolEffect(.bounce). */
  .theme-toggle.is-bouncing {
    animation: bounce 0.5s var(--spring);
  }

  @keyframes bounce {
    0% { transform: scale(1); }
    30% { transform: scale(0.86); }
    100% { transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle svg { transition: opacity 0.2s; }
    .theme-toggle.is-bouncing { animation: none; }
  }
</style>
