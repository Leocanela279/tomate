---
import { SCREENS, SHOT, asset } from '../lib/site';

/**
 * The app's own tab bar with real screenshots. It plays by itself: the pill slides to the next tab
 * and the window turns around like a card to show the next screen. The round button pauses it (its
 * ring shows the time left), and it also waits while the pointer or the focus is on it.
 */
---

<!-- The hero's last step. The glass controls and the window enter separately, so no fading parent
     cuts the glass off from the page behind it. -->
<div class="showcase" data-showcase>
  <div class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2">
    <div role="tablist" aria-label="Pantallas de Tomate" data-tabbar style="--i: 5" class="enter glass relative flex rounded-full p-1">
      <span data-pill class="tab-pill" aria-hidden="true"></span>
      {
        SCREENS.map((screen, index) => (
          <button
            type="button"
            role="tab"
            id={`tab-${screen.id}`}
            aria-controls={`panel-${screen.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
            class="tab"
          >
            {screen.tab}
            {'badge' in screen && (
              <span class="badge">
                {screen.badge}
                <span class="sr-only"> pendientes</span>
              </span>
            )}
          </button>
        ))
      }
    </div>

    <button type="button" style="--i: 5" class="enter play-toggle btn-icon glass shrink-0" data-play hidden aria-label="Pausar la demostración">
      <svg class="time-ring" viewBox="0 0 36 36" aria-hidden="true">
        <circle class="ring-track" cx="18" cy="18" r="16.5" />
        <circle class="ring-time" data-ring cx="18" cy="18" r="16.5" pathLength="100" />
      </svg>
      <svg class="icon-pause" viewBox="0 0 24 24" width="13" height="13" aria-hidden="true">
        <rect x="5" y="3.5" width="4.6" height="17" rx="1.6" fill="currentColor" />
        <rect x="14.4" y="3.5" width="4.6" height="17" rx="1.6" fill="currentColor" />
      </svg>
      <svg class="icon-play" viewBox="0 0 24 24" width="13" height="13" aria-hidden="true">
        <path fill="currentColor" d="M7 4.6v14.8a1.6 1.6 0 0 0 2.4 1.4l12-7.4a1.6 1.6 0 0 0 0-2.8l-12-7.4A1.6 1.6 0 0 0 7 4.6Z" />
      </svg>
    </button>
  </div>

  <div style="--i: 5.5" class="shots enter enter-plain">
    {
      SCREENS.map((screen, index) => (
        <figure role="tabpanel" id={`panel-${screen.id}`} aria-labelledby={`tab-${screen.id}`} hidden={index !== 0} class="shot">
          <div class="card" data-card>
            {(['tomato', 'dark'] as const).map((look) => (
              <img
                class={`only-${look}`}
                src={asset(`media/${screen.id}-${look}.webp`)}
                alt={`${screen.tab} de Tomate en modo ${look === 'tomato' ? 'tomate' : 'oscuro'}: ${screen.alt}`}
                width={SHOT.width}
                height={SHOT.height}
                loading={index === 0 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 && look === 'tomato' ? 'high' : undefined}
                decoding="async"
              />
            ))}
          </div>
          <figcaption data-caption class="mx-auto mt-2 max-w-xl px-2 text-center text-[15px] leading-relaxed text-ink-2 text-pretty">
            <strong class="text-ink">{screen.title}.</strong> {screen.text}
          </figcaption>
        </figure>
      ))
    }
  </div>
</div>

<style>
  .shots {
    position: relative;
    display: grid;
    margin-top: clamp(16px, 3vw, 28px);
    /* Depth for the turn: far enough that the window does not distort. */
    perspective: 2400px;
  }

  /* A warm light behind the window, the colour of the fruit. */
  .shots::before {
    content: "";
    position: absolute;
    inset: 10% 8% 22%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(255 120 90 / 0.5), transparent);
    filter: blur(50px);
    pointer-events: none;
  }

  :global([data-theme="dark"]) .shots::before {
    background: radial-gradient(closest-side, rgb(229 57 46 / 0.4), transparent);
  }

  /* All screens share one cell, so the block keeps its height whichever caption is showing. */
  .shot {
    position: relative;
    grid-area: 1 / 1;
    margin: 0;
  }

  /* With the script, screens that are not showing stay in the cell but invisible (and inert). */
  .shot.is-off {
    display: block;
    visibility: hidden;
  }

  .card {
    transform-origin: 50% 50%;
    will-change: transform;
  }

  /* The captures have the window's rounded corners; the shadow follows them. */
  .card img {
    display: block;
    width: 100%;
    height: auto;
    filter:
      drop-shadow(0 0 0.5px rgb(255 255 255 / 0.35))
      drop-shadow(0 30px 40px rgb(0 0 0 / 0.38))
      drop-shadow(0 8px 14px rgb(0 0 0 / 0.22));
  }

  /* ---------- Pause / play, with the time to the next screen as a ring ---------- */

  .play-toggle {
    position: relative;
  }

  .play-toggle svg {
    position: absolute;
    inset: 0;
    margin: auto;
  }

  /* Not "ring": that is a Tailwind utility (a box-shadow outline). */
  .time-ring {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
    fill: none;
    stroke-width: 2;
  }

  .ring-track {
    stroke: rgb(255 255 255 / 0.12);
  }

  .ring-time {
    stroke: var(--text);
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }

  .icon-play,
  .play-toggle.is-paused .icon-pause {
    display: none;
  }

  .play-toggle.is-paused .icon-play {
    display: block;
    /* The triangle's optical centre sits right of its box. */
    translate: 1px 0;
  }
</style>
